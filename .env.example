# OmniRoute (gateway local compatível com a API da OpenAI). Copie para .env e preencha.
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=
# Chave com permissão de GERENCIAMENTO (tela de consumo). A chave de inferência não serve.
# Também serve para a cadeia automática usar só provedores conectados e ativos no painel.
OMNIROUTE_MANAGEMENT_KEY=

# --- Cadeias de modelos ---------------------------------------------------------------------------
# Texto: modelos tentados primeiro, em ordem (lista separada por vírgula). "auto" = roteador do OmniRoute.
# (OMNIROUTE_TEXT_MODEL, no singular, ainda é aceito.)
OMNIROUTE_TEXT_MODELS=auto
# Visão (pedidos com imagens): tentados primeiro, em ordem. Nunca "auto".
OMNIROUTE_VISION_MODELS=gemini/gemini-3.1-flash-lite,openrouter/nvidia/nemotron-3.5-super-vl:free,openrouter/dots-studio/dots-3-note-preview:free
# Depois das listas acima, entram sozinhos os modelos GRÁTIS achados em /v1/models (1 = liga, 0 = só as listas).
OMNIROUTE_AUTO_FREE=1
# Máximo de modelos detectados por cadeia.
OMNIROUTE_AUTO_MAX=25
# Provedores cujo plano é grátis por inteiro. "provedor/padrão" limita aos modelos que casam (ex.: zai/*flash*).
# Fora daqui só entra modelo marcado como grátis (":free", free=true ou preço zero). Vazio = este padrão.
OMNIROUTE_FREE_PROVIDERS=gemini,groq,cerebras,mistral,github,nvidia,cloudflare,sambanova,ollama-cloud,llm7,api-airforce,cohere,huggingchat,huggingface,free-ai,zai/*flash*
# Modelos que nunca entram na cadeia automática (padrões com *, separados por vírgula).
OMNIROUTE_EXCLUDE_MODELS=

# --- Tentativas e esfriamento --------------------------------------------------------------------
# Timeout por chamada (20000 a 120000 ms)
OMNIROUTE_TIMEOUT_MS=45000
# Máximo de modelos chamados num mesmo pedido (os que estão esfriando são pulados sem custo).
OMNIROUTE_MAX_ATTEMPTS=8
# Quando a cota do DIA de um modelo acaba e o provedor não diz quando volta, ele fica fora por tantos minutos.
OMNIROUTE_DAILY_COOLDOWN_MIN=60
# OmniRoute fora do ar (servidor parado / chave recusada): testa de novo a cada tantos segundos.
OMNIROUTE_RETEST_S=45

# --- Reserva paga (provedor do app de cortes, ex.: Claude) ----------------------------------------
# Se o modelo grátis mais próximo volta em até tantos segundos, espera em vez de usar a reserva paga.
MANGA_FREE_WAIT_MAX_S=15
# Máximo de chamadas pagas por job/etapa (vazio = sem limite; 0 = nunca usar a reserva paga).
MANGA_MAX_PAID_CALLS=

# --- Paralelismo (padrões medidos para um lote de 15 capítulos) -------------------------------------
# Páginas lidas pela IA de visão ao mesmo tempo.
NOTES_CONCURRENCY=8
# Páginas do "aplicar estilo" ao mesmo tempo (uma chamada de texto por página).
MANGA_RESTYLE_CONCURRENCY=5
# Lotes da validação (6 recortes cada) ao mesmo tempo.
MANGA_CHECK_CONCURRENCY=4
# Partes renderizadas ao mesmo tempo (vazio = metade dos núcleos, até 4).
MANGA_RENDER_JOBS=

# --- Gestor (Opus) -------------------------------------------------------------------------------
# 0 desliga a revisão do gestor no fim das etapas de leitura e roteiro.
MANGA_REVIEW=1

# --- Testes de consumo -----------------------------------------------------------------------------
# 1 = pula os modelos grátis e usa só o Claude. Deixe vazio no uso normal: com 1, a cadeia grátis nunca é usada.
MANGA_FORCE_CLAUDE=
# Pausa a leitura quando a janela de 5 h do Claude passa desta fração (0.95 = 95%).
MANGA_CLAUDE_STOP_5H=0.95
